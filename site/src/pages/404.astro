---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" description="This page doesn't exist.">
  <div class="nm-shell">
    <section class="nm-section" style="text-align:center;">
      <div class="nm-hero-eyebrow" style="display:inline-flex;">404</div>
      <h1 class="nm-section-heading" style="margin: var(--nm-sp-4) auto;">This branch doesn't converge.</h1>
      <p class="nm-section-desc" style="margin: 0 auto var(--nm-sp-8);">
        The page you're looking for doesn't exist, or hasn't merged yet.
      </p>
      <div class="nm-hero-actions">
        <a class="nm-btn nm-btn-primary" href="/">Back home</a>
      </div>
    </section>
  </div>
</BaseLayout>
