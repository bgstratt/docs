{
  "name": "nodalmerge-docs-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:apps": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-apps.ps1",
    "dev:docs": "powershell -ExecutionPolicy Bypass -Command \"cd ./docs-site; npx mint dev\"",
    "check:docs-links": "powershell -ExecutionPolicy Bypass -Command \"cd ./docs-site; npx mint broken-links\"",
    "dev:site": "powershell -ExecutionPolicy Bypass -Command \"cd ./site; npm run dev\"",
    "build:site": "powershell -ExecutionPolicy Bypass -Command \"cd ./site; npm run build\"",
    "build:apps": "powershell -ExecutionPolicy Bypass -File ./scripts/build-apps.ps1",
    "build:all": "npm run build:site && npm run build:apps"
  },
  "dependencies": {
    "nodalmerge-bridge": "file:../nodalmerge/artifacts/package-local/npm/nodalmerge-bridge-0.2.5.tgz",
    "nodalmerge-sdk-js": "file:../nodalmerge/artifacts/package-local/npm/nodalmerge-sdk-js-0.2.5.tgz"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
