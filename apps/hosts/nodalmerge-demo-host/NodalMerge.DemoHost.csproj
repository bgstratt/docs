<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NodalMergePackageVersion Condition="'$(NodalMergePackageVersion)' == ''">0.1.4</NodalMergePackageVersion>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NodalMerge.Host.Abstractions" Version="$(NodalMergePackageVersion)" />
    <PackageReference Include="NodalMerge.Host.Composition" Version="$(NodalMergePackageVersion)" />
    <PackageReference Include="NodalMerge.DotNetHost" Version="$(NodalMergePackageVersion)" />
    <PackageReference Include="NodalMerge.DotNetHost.Native.win-x64" Version="$(NodalMergePackageVersion)" />
    <PackageReference Include="NodalMerge.DotNetHost.Native.linux-x64" Version="$(NodalMergePackageVersion)" />
  </ItemGroup>
</Project>
