---
interface Props {
  size?: "sm" | "md";
  label?: string;
}
const { size = "md", label = "NodalMerge" } = Astro.props;
const dim = size === "sm" ? 22 : 26;
---
<span class="nm-logo" style={`--nm-logo-dim: ${dim}px`}>
  <img src="/logo-mark.png" alt="" width="128" height="128" />
  <span class="nm-logo-word">{label}</span>
</span>

<style>
  .nm-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nm-logo img {
    width: var(--nm-logo-dim);
    height: var(--nm-logo-dim);
    flex-shrink: 0;
  }
  .nm-logo-word {
    font-weight: var(--nm-weight-bold);
    letter-spacing: var(--nm-tracking-snug);
  }
</style>
