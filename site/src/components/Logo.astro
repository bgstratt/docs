---
interface Props {
  size?: "sm" | "md";
}
const { size = "md" } = Astro.props;
const dim = size === "sm" ? 22 : 26;
---
<span class="nm-logo" style={`--nm-logo-dim: ${dim}px`}>
  <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <linearGradient id="nmLogoGrad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="var(--nm-brand-500)" />
        <stop offset="1" stop-color="var(--nm-accent-500)" />
      </linearGradient>
    </defs>
    <circle cx="9" cy="9" r="5.5" stroke="url(#nmLogoGrad)" stroke-width="2.5" />
    <circle cx="23" cy="23" r="5.5" stroke="url(#nmLogoGrad)" stroke-width="2.5" />
    <path d="M13 13 L19 19" stroke="url(#nmLogoGrad)" stroke-width="2.5" stroke-linecap="round" />
    <circle cx="16" cy="16" r="2.5" fill="url(#nmLogoGrad)" />
  </svg>
  <span class="nm-logo-word">NodalMerge</span>
</span>

<style>
  .nm-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nm-logo svg {
    width: var(--nm-logo-dim);
    height: var(--nm-logo-dim);
    flex-shrink: 0;
  }
  .nm-logo-word {
    font-weight: var(--nm-weight-bold);
    letter-spacing: var(--nm-tracking-snug);
  }
</style>
